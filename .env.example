# -----------------------------------------------------------------------------
# Docker / Aliyun ECS
# -----------------------------------------------------------------------------
# Bind to 127.0.0.1 when Nginx/Caddy is the public entry point. Use 0.0.0.0 only
# when the container port is intentionally exposed by the security group.
APP_BIND=127.0.0.1
APP_PORT=3100
APP_IMAGE=star-photo-addr:local
BUILD_REVISION=local
NODE_OPTIONS=--max-old-space-size=768
WORKER_NODE_OPTIONS=--max-old-space-size=512

# -----------------------------------------------------------------------------
# Public values embedded during `next build`
# -----------------------------------------------------------------------------
# Tianditu (天地图) developer token — optional Chinese annotation source.
# Register at https://lbs.tianditu.gov.cn. When omitted, the app uses the
# bundled Chinese city labels instead of pretending the token is available.
NEXT_PUBLIC_TIANDITU_TOKEN=

# Optional replacement for the default VIIRS 2023 visual light-pollution WMTS.
# This must be a Leaflet template containing {z}, {x}, and either {y} or {-y}.
# Optional Leaflet placeholders {s} and {r} are also supported. For production,
# prefer a licensed/self-hosted source under your control.
NEXT_PUBLIC_LIGHT_POLLUTION_TILE_URL=

# Optional licensed local dark-sky assets. Keep disabled unless the matching
# files have been obtained and placed under public/images/perseids/.
NEXT_PUBLIC_ASSET_VIIRS_TILES=false
NEXT_PUBLIC_ASSET_WORLD_ATLAS=false
NEXT_PUBLIC_ASSET_CITY_CANDIDATES=false
NEXT_PUBLIC_ASSET_BOUNDARIES=false

# -----------------------------------------------------------------------------
# Runtime upstream endpoints
# -----------------------------------------------------------------------------
# Defaults are the official/public providers used by the application. Keeping
# them configurable makes an Aliyun deployment able to use an outbound proxy or
# an internal cache without rebuilding the image.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
GIBS_CAPABILITIES_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/1.0.0/WMTSCapabilities.xml
NOAA_KP_URL=https://services.swpc.noaa.gov/products/noaa-planetary-k-index-forecast.json

# -----------------------------------------------------------------------------
# Runtime cache, timeout and public refresh protection
# -----------------------------------------------------------------------------
# Values are milliseconds. Defaults suit a small public ECS deployment; lower
# them only when the upstream quota and outbound bandwidth are understood.
DATA_SOURCE_HEALTH_TTL_MS=300000
DATA_SOURCE_PROBE_TIMEOUT_MS=15000
DATA_SOURCE_FORCE_REFRESH_COOLDOWN_MS=60000

FORECAST_CACHE_TTL_MS=600000
FORECAST_STALE_TTL_MS=21600000
FORECAST_REQUEST_TIMEOUT_MS=25000
FORECAST_FORCE_REFRESH_COOLDOWN_MS=60000
FORECAST_MAX_LOCATIONS=64

GIBS_CACHE_TTL_MS=900000
GIBS_STALE_TTL_MS=86400000
GIBS_REQUEST_TIMEOUT_MS=15000
GIBS_FORCE_REFRESH_COOLDOWN_MS=60000

OBSERVATION_SNAPSHOT_TTL_MS=1800000
OBSERVATION_SNAPSHOT_STALE_TTL_MS=21600000
OBSERVATION_SNAPSHOT_TIMEOUT_MS=120000
OBSERVATION_SNAPSHOT_FORCE_REFRESH_COOLDOWN_MS=60000

# -----------------------------------------------------------------------------
# Observation snapshot worker
# -----------------------------------------------------------------------------
SNAPSHOT_INTERVAL_MS=1800000
SNAPSHOT_WORKER_REQUEST_TIMEOUT_MS=150000
SNAPSHOT_DAYS=7
# GFS has a longer horizon than ICON and is safer for a 7-night background job.
SNAPSHOT_MODEL=gfs
