# Frontend forecast data-source base URL (Vite, consumed at build time).
# Defaults to the same-origin proxy (/api/forecast) served by nginx (T2)
# or the Cloudflare Worker (T3). Leave as-is for normal production use.
VITE_FORECAST_BASE=/api/forecast

# --- Future keyed providers (NOT used yet) ---
# SECURITY: any API key belongs SERVER-SIDE ONLY. Never expose it to the
# frontend bundle, never commit it, never log it. These are placeholders to
# remind the rule; when added, proxy them through a Worker/nginx route, not
# through VITE_*-exposed variables.
# VITE_OPENWEATHER_KEY=        (server-side only, never expose to frontend/Git/logs)
# VITE_QWEATHER_KEY=           (server-side only, never expose to frontend/Git/logs)
# VITE_CMA_KEY=                (server-side only, never expose to frontend/Git/logs)
