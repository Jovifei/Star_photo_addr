{
  "name": "star-weather-planner",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "逐星｜今夜观测、暗夜选址与观星计划平台",
  "author": "JCodesMore",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "node scripts/start-e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.js",
    "test:live": "node scripts/live-smoke.mjs",
    "check:data-sources": "node scripts/check-data-sources.mjs",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "snapshot:worker": "node scripts/observing-snapshot-worker.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "astronomy-engine": "^2.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "opencc-js": "^1.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
