@@ -62,8 +86,8 @@ a { color: var(--cyan); }
 .status-banner.warning { border-left-color: var(--warn); color: #f3c98e; }
 
 .hero-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(310px, .75fr); gap: 16px; }
