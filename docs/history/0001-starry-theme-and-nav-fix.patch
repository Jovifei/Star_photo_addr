+.topbar { position: sticky; top: 0; z-index: 30; height: 76px; display: flex; align-items: center; gap: 28px; padding: 0 max(20px, calc((100vw - 1280px) / 2)); border-bottom: 1px solid var(--line); background: rgba(18, 26, 69, 0.85); backdrop-filter: blur(16px); }
