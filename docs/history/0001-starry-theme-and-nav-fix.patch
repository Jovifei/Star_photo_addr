- 重写 styles.css 配色变量，从近黑靛蓝改为靛蓝-紫罗兰渐变，并叠加轻量星点背景，贴合星空摄影主题但不再显黑
- 卡片改为半透明玻璃质感，露出背景星空
- 统一矩阵表头、弹窗遮罩等硬编码色值到新配色
- App.jsx：切换今晚/对比/点位导航时自动滚动回顶部；打开详情抽屉时锁定背景滚动并支持 Esc 关闭，让点击跳转落点更清晰
---
 src/App.jsx    | 22 ++++++++++++++-
 src/styles.css | 74 +++++++++++++++++++++++++++++++++-----------------
 2 files changed, 70 insertions(+), 26 deletions(-)

diff --git a/src/App.jsx b/src/App.jsx
index 481020b..a12b2e6 100644
--- a/src/App.jsx
+++ b/src/App.jsx
@@ -85,6 +85,26 @@ export function App() {
     if (!nightKeys.includes(selectedNight)) setSelectedNight(nightKeys[0]);
   }, [nightKeys, selectedNight]);
 
+  // 切换顶部/底部导航（今晚·对比·点位）时自动回到页面顶部，避免跳转后停留在上次滚动位置
+  useEffect(() => {
+    window.scrollTo({ top: 0, behavior: "smooth" });
+  }, [view]);
+
+  // 打开详情抽屉时锁定背景滚动，并支持 Esc 键关闭，让点击跳转的落点更明确
+  useEffect(() => {
+    if (!selectedLocationId) return undefined;
+    const previousOverflow = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    const handleKeyDown = (event) => {
+      if (event.key === "Escape") setSelectedLocationId(null);
+    };
+    window.addEventListener("keydown", handleKeyDown);
+    return () => {
+      document.body.style.overflow = previousOverflow;
+      window.removeEventListener("keydown", handleKeyDown);
+    };
+  }, [selectedLocationId]);
+
   const rankings = useMemo(() => {
     return locations
       .map((location) => {
@@ -424,7 +444,7 @@ function baseChartStyle() {
   return {
     backgroundColor: "transparent",
     textStyle: { color: "#aebbd0", fontFamily: "system-ui, sans-serif" },
-    tooltip: { trigger: "axis", backgroundColor: "#101a2b", borderColor: "#30415f", textStyle: { color: "#f4f7fb" } },
+    tooltip: { trigger: "axis", backgroundColor: "#1a2154", borderColor: "#4a5599", textStyle: { color: "#f4f6ff" } },
     grid: { left: 38, right: 14, top: 38, bottom: 32 },
   };
 }
diff --git a/src/styles.css b/src/styles.css
index 92b9d78..092989d 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -2,36 +2,60 @@
   color-scheme: dark;
   font-family: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
   font-synthesis: none;
-  --bg: #07101f;
-  --bg-deep: #050b16;
-  --surface: #10192a;
-  --surface-2: #142036;
-  --surface-3: #192841;
-  --line: #283750;
-  --line-strong: #354763;
-  --text: #f4f7fb;
-  --muted: #93a4be;
-  --muted-2: #6f809a;
-  --cyan: #36d2e7;
-  --cyan-soft: rgba(54, 210, 231, 0.12);
-  --good: #54d6a5;
-  --warn: #f3b45a;
-  --bad: #f27087;
+  /* 星空配色：靛蓝-紫罗兰渐变，避免纯黑，保留天文摄影主题的沉浸感 */
+  --bg: #121a45;
+  --bg-deep: #0a0e30;
+  --bg-rise: #1c2568;
+  --surface: #1a2154;
+  --surface-2: #212a64;
+  --surface-3: #283274;
+  --line: #37417f;
+  --line-strong: #4a5599;
+  --text: #f4f6ff;
+  --muted: #a3aad8;
+  --muted-2: #7d84b8;
+  --cyan: #45d8ea;
+  --cyan-soft: rgba(69, 216, 234, 0.14);
+  --violet: #9b8cf9;
+  --violet-soft: rgba(155, 140, 249, 0.14);
+  --good: #5fdcae;
+  --warn: #f5bb66;
+  --bad: #f57890;
   background: var(--bg);
   color: var(--text);
   -webkit-font-smoothing: antialiased;
 }
 
 * { box-sizing: border-box; }
-html { background: var(--bg-deep); }
-body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--bg); }
+html { background: var(--bg-deep); scroll-behavior: smooth; }
+body {
+  margin: 0;
+  min-width: 320px;
+  min-height: 100vh;
+  color: var(--text);
+  background:
+    radial-gradient(1.6px 1.6px at 12% 18%, #ffffff 0%, transparent 60%),
+    radial-gradient(1.4px 1.4px at 78% 8%, #d9e0ff 0%, transparent 60%),
+    radial-gradient(1.2px 1.2px at 45% 32%, #ffffff 0%, transparent 60%),
+    radial-gradient(1.6px 1.6px at 88% 42%, #d9e0ff 0%, transparent 60%),
+    radial-gradient(1.2px 1.2px at 25% 62%, #ffffff 0%, transparent 60%),
+    radial-gradient(1.4px 1.4px at 60% 78%, #d9e0ff 0%, transparent 60%),
+    radial-gradient(1.2px 1.2px at 92% 88%, #ffffff 0%, transparent 60%),
+    radial-gradient(1.4px 1.4px at 8% 92%, #ffffff 0%, transparent 60%),
+    radial-gradient(1.2px 1.2px at 35% 6%, #d9e0ff 0%, transparent 60%),
+    radial-gradient(ellipse 120% 70% at 50% -10%, var(--bg-rise) 0%, transparent 60%),
+    linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%);
+  background-repeat: repeat, repeat, repeat, repeat, repeat, repeat, repeat, repeat, repeat, no-repeat, no-repeat;
+  background-size: 340px 340px, 340px 340px, 340px 340px, 340px 340px, 340px 340px, 340px 340px, 340px 340px, 340px 340px, 340px 340px, 100% 100%, 100% 100%;
+  background-attachment: fixed;
+}
 button, input { font: inherit; }
